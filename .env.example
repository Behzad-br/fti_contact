# Monorepo local/dev template loaded as PROJECT_ROOT/.env
# VPS API-only deploy: prefer backend/.env.example → backend/.env
# Never put real passwords or API keys in git.

NODE_ENV=development
ENV=development
PORT=5000

DB_HOST=
DB_PORT=3306
DB_NAME=
DB_USER=
DB_PASSWORD=
DATABASE_URL=

DATA_DIR=

FRONTEND_URL=https://fti4iltes.tech
CORS_ORIGINS=http://127.0.0.1:5174,http://localhost:5174

JWT_SECRET=change-me-in-production-use-long-random-string
JWT_EXPIRE_HOURS=12
AUTH_LEGACY_HEADERS=false
AUTH_BOOTSTRAP_USERNAME=admin
AUTH_BOOTSTRAP_PASSWORD=
AUTH_BOOTSTRAP_EMAIL=admin@local
AUTH_BOOTSTRAP_NAME=Super Admin

LLM_PROVIDER=openai
OPENAI_API_KEY=
LLM_MODEL=gpt-4o-mini
OPENAI_WRITING_GRADING_MODEL=gpt-4o-mini
OPENAI_WRITING_GENERATION_MODEL=gpt-4o-mini
WRITING_AI_GRADING_ENABLED=true
WRITING_ADMIN_TOKEN=

ENABLE_LIVE_MOCK_MONITORING=true
LIVEKIT_URL=
LIVEKIT_API_KEY=
LIVEKIT_API_SECRET=

WHISPER_MODEL=base
DEFAULT_STUDENT_ID=local
