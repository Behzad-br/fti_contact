LLM_PROVIDER=openai
OPENAI_API_KEY=
LLM_MODEL=gpt-4o-mini
OPENAI_WRITING_GRADING_MODEL=gpt-4o-mini
OPENAI_WRITING_GENERATION_MODEL=gpt-4o-mini
WRITING_AI_GRADING_ENABLED=true
WRITING_ADMIN_TOKEN=
DEFAULT_STUDENT_ID=local
ENABLE_LIVE_MOCK_MONITORING=true
LIVEKIT_URL=ws://127.0.0.1:7880
LIVEKIT_API_KEY=devkey
LIVEKIT_API_SECRET=secret
WHISPER_MODEL=base
JWT_SECRET=change-me-in-production-use-long-random-string
JWT_EXPIRE_HOURS=12
AUTH_LEGACY_HEADERS=false
AUTH_BOOTSTRAP_USERNAME=admin
AUTH_BOOTSTRAP_PASSWORD=
AUTH_BOOTSTRAP_EMAIL=admin@local
AUTH_BOOTSTRAP_NAME=Super Admin
CORS_ORIGINS=http://127.0.0.1:5174,http://localhost:5174

# Database — leave empty / omit for local SQLite, or set Neon (free) Postgres URL:
# DATABASE_URL=postgresql://USER:PASSWORD@HOST/neondb?sslmode=require
DATABASE_URL=
